# =============================================================================
# Marush Mobile Application — Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace the placeholder values with your
# credentials from: https://supabase.com/dashboard -> Project Settings -> API & Database

# Your Supabase Project HTTPS URL (e.g., https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Project Anon/Public API Key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: deployed HTTPS origin for web OAuth callbacks on phones.
# Add the URL to Supabase Authentication -> URL Configuration.
# For native sign-in, allow the Expo Go callback (exp://<LAN-IP>:8081/--/auth/callback)
# and the installed app callback (marushapp://auth/callback) in Supabase.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Supabase PostgreSQL Connection String (for running migrations)
# Dashboard -> Project Settings -> Database -> Connection string (Node.js or URI)
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[your-region].pooler.supabase.com:6543/postgres

# Optional: path to a Supabase database CA certificate for verified TLS.
# If omitted, the migration runner uses supabase/prod-ca-2021.crt when present.
# DATABASE_SSL_CA_PATH=./supabase/prod-ca-2021.crt
