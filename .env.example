# =============================================================================
# Marush Mobile Application — Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace the placeholder values with your
# credentials from: https://supabase.com/dashboard -> Project Settings -> API

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Project Anon/Public API Key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
